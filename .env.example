# Use auto to run ONNX/TensorFlow.js in the browser and other formats through the API.
VITE_MODEL_PATH=/model
VITE_MODEL_FORMAT=auto
VITE_MODEL_RUNTIME=auto

# The backend loads all three checked-in global models by default.
# Override these paths when deploying the backend from another working directory.
VITE_GLOBAL_RF_MODEL_PATH=global_models/shakesense_global_rf.pkl
VITE_ISOLATION_FOREST_MODEL_PATH=global_models/shakesense_isolation_forest.pkl
VITE_MEDIAN_MAD_MODEL_PATH=global_models/shakesense_median_mad.pkl

# Optional per-machine profile produced by the personalised training notebook.
VITE_PERSONALIZED_MODEL_PATH=
VITE_ESP32_MODEL_PATH=global_models/esp32-model/ShakeSense_ESP32/ShakeSense_ESP32.ino

# Local backend for Python/native models (.pkl, .joblib, .pt, or .pth).
VITE_ML_API_URL=http://localhost:8000/predict
